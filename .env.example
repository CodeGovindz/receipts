# AWS region where the Bedrock models and inference profiles live.
# (RECEIPTS_AWS_REGION wins if both are set; use it on Vercel, which
# reserves the AWS_* names for its own runtime.)
AWS_REGION=us-east-1
RECEIPTS_AWS_REGION=

# AWS credentials for the Bedrock Converse API.
# Local development: leave these unset — the AWS SDK default credential chain
# (AWS CLI profile / ~/.aws/credentials) is used automatically.
# Production (Vercel): set both, using a dedicated IAM user that can only call
# bedrock:InvokeModel* (see docs/PLAN.md, "IAM for the Vercel deployment").
# They are prefixed because Vercel reserves AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
RECEIPTS_AWS_ACCESS_KEY_ID=
RECEIPTS_AWS_SECRET_ACCESS_KEY=

# Fast model for claim extraction (Bedrock Converse, open-weight).
# Tested working in us-east-1 via on-demand inference.
RECEIPTS_MODEL_FAST=qwen.qwen3-coder-next

# Strong model for claim verification. MUST be a cross-region inference
# profile ID starting with "us." or "global." — the bare model ID fails
# on-demand throughput (confirmed by testing, see docs/PLAN.md).
RECEIPTS_MODEL_STRONG=us.moonshotai.kimi-k3

# Fallback model used automatically when STRONG times out or keeps throwing
# throttling/5xx errors after same-model SDK retries.
RECEIPTS_MODEL_FALLBACK=openai.gpt-oss-120b-1:0

# Read-only GitHub token to raise API rate limits (unauthenticated: 60 req/h).
# Optional locally, REQUIRED in production (clear startup error if missing).
GITHUB_TOKEN=
